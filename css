* {
    margin: 0;
    padding: 0;
}
 
:root {
    --background: #121212;
    --background2: #fff3ef;
    --buttoncolor: #b4aaa3;
}
 
.body {
    font-family: "Poppins", sans-serif
}
 
img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
 
.sea_container {
    padding: 100px 15px;
    display: grid;
    gap: 15px;
    grid-template-rows: repeat(2, 300px);
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
}
 
.sea-1 {
    grid-row: 1/2;
}
 
.sea-2 {
    grid-row: 2/3;
}
 
.sea-3 {
    grid-row: 1/3;
}
 
.banner_content {
    background-color: var(--background);
    display: grid;
    gap: 20px;
    grid-template-areas:
        "banner1 banner1 banner1 banner1"
        "texto_botao banner2 banner3 banner4";
}
 
.banner1 {
    grid-area: banner1;
}
 
.banner2 {
    grid-area: banner2;
}
 
.banner3 {
    grid-area: banner3;
}
 
.banner4 {
    grid-area: banner4;
}
 
.texto_botao {
    grid-area: texto_botao;
    color: var(--buttoncolor);
}